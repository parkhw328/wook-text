<Window x:Class="WookText.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WookText.App"
        Title="기능 설명서 — wText" Style="{StaticResource {x:Type Window}}"
        Width="1060" Height="760" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="기능 설명서" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Bright}" />
      <TextBlock Text="목차에서 고르거나 제목·본문을 검색하세요. 인터넷 없이 모든 안내를 읽을 수 있습니다." Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,14">
      <Button Content="검색 지우기" DockPanel.Dock="Right" Margin="10,0,0,0" Click="OnClearSearch" />
      <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="설명서 제목과 본문 검색" ToolTip="주제 검색 · Ctrl+F · 공백으로 여러 검색어 조합" />
    </DockPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="TopicList" SelectionChanged="OnTopicChanged" AutomationProperties.Name="기능 설명서 목차" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="2,5" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Bright}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <FlowDocumentScrollViewer x:Name="Reader" Grid.Row="1" IsToolBarVisible="False" IsSelectionEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="기능 설명서 본문" />
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <Button Content="닫기  Esc" DockPanel.Dock="Right" MinWidth="92" Click="OnClose" Style="{StaticResource AccentButton}" />
      <TextBlock DockPanel.Dock="Right" Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{StaticResource Muted}" Margin="12,0,18,0" VerticalAlignment="Center" />
      <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
