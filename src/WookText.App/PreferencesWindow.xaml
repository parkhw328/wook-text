<Window x:Class="WookText.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="글꼴 및 편집 설정 — wText" Style="{StaticResource {x:Type Window}}" Width="680" Height="690" MinWidth="620" MinHeight="660" WindowStartupLocation="CenterOwner">
  <Grid Margin="26" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="편안한 편집 환경" Foreground="{StaticResource Bright}" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="글꼴과 크기를 미리 보고, 모든 문서에 한 번에 적용하세요." Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="영문 · 숫자 글꼴" Margin="0,0,0,8" />
        <ComboBox x:Name="EnglishFontBox" IsEditable="True" Height="36" SelectionChanged="OnFontChanged" TextBox.TextChanged="OnFontChanged" LostKeyboardFocus="OnPreviewChanged" AutomationProperties.Name="영문 글꼴" />
        <TextBlock Text="기본: JetBrains Mono · 앱에 포함" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="한글 글꼴" Margin="0,0,0,8" />
        <ComboBox x:Name="KoreanFontBox" IsEditable="True" Height="36" SelectionChanged="OnFontChanged" TextBox.TextChanged="OnFontChanged" LostKeyboardFocus="OnPreviewChanged" AutomationProperties.Name="한글 글꼴" />
        <TextBlock Text="기본: Noto Sans KR · 앱에 포함" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,22,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="글자 크기" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
          <Button Content="−" Width="34" Click="OnDecrease" ToolTip="글자 작게" />
          <TextBox x:Name="SizeBox" Width="62" Margin="6,0" TextAlignment="Center" TextChanged="OnPreviewChanged" AutomationProperties.Name="글자 크기" />
          <Button Content="+" Width="34" Click="OnIncrease" ToolTip="글자 크게" />
          <TextBlock Text="px" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="9–48 px · Ctrl+마우스 휠로 조절" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,22,0,0">
        <CheckBox x:Name="LineNumbersBox" Content="줄 번호 표시" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" Margin="0,0,0,9" />
        <CheckBox x:Name="WordWrapBox" Content="긴 줄 자동 줄바꿈" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" Margin="0,0,0,9" />
        <CheckBox x:Name="WhitespaceBox" Content="공백 · 탭 표시" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Padding="6">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="미리보기" Margin="10,7" FontSize="11" Foreground="{StaticResource Muted}" />
        <ContentControl x:Name="PreviewHost" Grid.Row="1" />
      </Grid>
    </Border>
    <TextBlock x:Name="ValidationMessage" Grid.Row="4" Foreground="#E8A26B" TextWrapping="Wrap" MinHeight="30" Margin="0,10,0,0" />
    <DockPanel Grid.Row="5" Margin="0,8,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="취소" IsCancel="True" MinWidth="76" Margin="0,0,8,0" />
        <Button x:Name="ApplyButton" Content="적용" IsDefault="True" Click="OnApply" MinWidth="88" Style="{StaticResource AccentButton}" />
      </StackPanel>
      <Button Content="기본값으로" Click="OnReset" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" />
    </DockPanel>
  </Grid>
</Window>
