<Window x:Class="WookText.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WookText.App"
        Title="wText 정보" Style="{StaticResource {x:Type Window}}" Width="540" Height="550" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="32" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
      <Image Source="{StaticResource AppMark}" Width="62" Height="62" Margin="0,0,16,0" />
      <StackPanel VerticalAlignment="Center"><TextBlock Text="wText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Bright}" /><TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,23">
      <TextBlock Text="만든 사람" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7" />
      <TextBlock x:Name="AuthorLabel" Text="{x:Static local:AppInfo.Author}" FontSize="20" Foreground="{StaticResource Bright}" />
    </StackPanel>
    <StackPanel Grid.Row="2">
      <TextBlock Text="소스 코드 · 의견 보내기" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
      <TextBlock><Hyperlink x:Name="RepositoryLink" NavigateUri="{x:Static local:AppInfo.RepositoryUri}" RequestNavigate="OnRepositoryNavigate" Foreground="{StaticResource Accent}"><Run Text="{x:Static local:AppInfo.RepositoryUrl}" /></Hyperlink></TextBlock>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,24,0,14">
      <TextBlock Text="MIT License · 무료 사용 및 배포&#x0a;&#x0a;AvalonEdit · DiffPlex · .NET / WPF&#x0a;JetBrains Mono · Noto Sans KR · Flexoki · NSIS" Foreground="{StaticResource Muted}" LineHeight="21" TextWrapping="Wrap" />
      <Button x:Name="LicensesButton" Content="라이선스 및 고지 원문 보기 →" Click="OnLicenses" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Foreground="{StaticResource Accent}" Margin="-9,8,0,0" />
    </StackPanel>
    <DockPanel Grid.Row="4">
      <Button Content="닫기" IsCancel="True" IsDefault="True" DockPanel.Dock="Right" MinWidth="82" Style="{StaticResource AccentButton}" />
      <Button x:Name="CopyLinkButton" Content="GitHub 주소 복사" Click="OnCopyLink" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" />
    </DockPanel>
  </Grid>
</Window>
