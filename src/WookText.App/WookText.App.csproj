<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>wText</AssemblyName>
    <Product>wText</Product>
    <Description>A free Windows text editor with side-by-side file comparison.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/wText.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WookText.Core/WookText.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Formatting/format.cjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../.tools/formatter/node.exe" Link="Formatting/node.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../.tools/formatter/package/standalone.js" Link="Formatting/prettier/standalone.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../.tools/formatter/package/plugins/*.js" Link="Formatting/prettier/plugins/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/*.otf" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/wText.ico" />
    <EmbeddedResource Include="SyntaxDefinitions/*.xshd" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckFormatter" BeforeTargets="PrepareForBuild" Condition="!Exists('../../.tools/formatter/node.exe') Or !Exists('../../.tools/formatter/package/standalone.js')">
    <Error Text="Run scripts/prepare-formatter.ps1 before building wText." />
  </Target>
</Project>
