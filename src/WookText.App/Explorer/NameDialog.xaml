<Window x:Class="WookText.App.Explorer.NameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Width="480" Height="285" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Padding="24" Background="{StaticResource Canvas}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Bright}" Margin="0,0,0,10" />
    <TextBlock x:Name="ParentPath" Grid.Row="1" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,0,14" />
    <TextBox x:Name="NameBox" Grid.Row="2" AutomationProperties.Name="파일 또는 폴더 이름" />
    <TextBlock x:Name="ErrorMessage" Grid.Row="3" TextWrapping="Wrap" Foreground="#E8A26B" Margin="0,8,0,10" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" MinWidth="72" Margin="0,0,8,0" /><Button x:Name="AcceptButton" Content="확인" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnAccept" MinWidth="80" /></StackPanel>
  </Grid>
  </Border>
</Window>
